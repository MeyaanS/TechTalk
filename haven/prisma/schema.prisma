// Haven database schema (milestone 1).
// SQLite for development. To use Postgres in production, change `provider`
// below to "postgresql", set DATABASE_URL to your Postgres URL, and create a
// fresh migration. (Prisma needs the provider written in this file; it cannot
// be switched by an environment variable alone.)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- Auth.js tables (standard) ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  accounts  Account[]
  sessions  Session[]

  // Data owned by this person (see "Owner pattern" below)
  profile   Profile?
  settings  UserSettings?
  checklist ChecklistProgress[]
  goBag     GoBagItem[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Guest mode ----------
// A guest is an anonymous owner. The browser holds a random token in an
// httpOnly cookie; we store only its SHA-256 hash.

model GuestSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  createdAt DateTime @default(now())
  lastSeen  DateTime @default(now())

  profile   Profile?
  settings  UserSettings?
  checklist ChecklistProgress[]
  goBag     GoBagItem[]
}

// ---------- Owner pattern ----------
// Every table below belongs to EITHER a user OR a guest (one of userId /
// guestId is set, the other is null). Merging a guest into an account is then
// just re-pointing rows from guestId to userId inside one transaction.

model Profile {
  id           String  @id @default(cuid())
  userId       String? @unique
  guestId      String? @unique
  address      String?
  zip          String?
  lat          Float?
  lon          Float?
  propertyType String? // "single_family" | "rural_acreage" | "suburban_townhome"
  pets         Int     @default(0)
  elderly      Int     @default(0)
  mobilityNeeds Boolean @default(false)
  vehicles     Int     @default(1)
  updatedAt    DateTime @updatedAt

  user  User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  guest GuestSession? @relation(fields: [guestId], references: [id], onDelete: Cascade)
}

model UserSettings {
  id                  String  @id @default(cuid())
  userId              String? @unique
  guestId             String? @unique
  guestBannerDismissed Boolean @default(false)
  highContrast        Boolean @default(false)

  user  User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  guest GuestSession? @relation(fields: [guestId], references: [id], onDelete: Cascade)
}

model ChecklistProgress {
  id          String   @id @default(cuid())
  userId      String?
  guestId     String?
  taskId      String // task definitions live in code, keyed by property type
  zone        Int // 0, 1 or 2
  completedAt DateTime @default(now())

  user  User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  guest GuestSession? @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId])
  @@unique([guestId, taskId])
}

model GoBagItem {
  id        String   @id @default(cuid())
  userId    String?
  guestId   String?
  label     String
  category  String
  checked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user  User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  guest GuestSession? @relation(fields: [guestId], references: [id], onDelete: Cascade)
}
